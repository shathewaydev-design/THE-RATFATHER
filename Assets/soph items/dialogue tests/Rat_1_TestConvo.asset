  m_Script: {fileID: 11500000, guid: 34ee349227d32df4580398eb667c4e5d, type: 3}
  m_Name: Rat_1_TestConvo
  m_EditorClassIdentifier: Assembly-CSharp::ConversationData
  lines:
  - speaker: {fileID: 11400000, guid: de613ae3f44719243bc76d645d065c4d, type: 2}
    text: H-Hello? W-Who are you?
    options: []
    endConversation: 0
  - speaker: {fileID: 11400000, guid: de613ae3f44719243bc76d645d065c4d, type: 2}
    text: Don't try anything! I know h-how to fight y'know!
    options: []
    endConversation: 0
  - speaker: {fileID: 11400000, guid: fe37e5f6c6e4ce940ab3b38f7087bab3, type: 2}
    text: 
    options:
    - text: I'm the best drug dealer in town...! Buy my cheese or suffer the consequences!
      nextLineIndex: 3
      endConversation: 0
    - text: Hey, I mean no harm. I'm nobody. Just... trying to get my footing in
        this place.
      nextLineIndex: 4
      endConversation: 0
    endConversation: 0
  - speaker: {fileID: 11400000, guid: de613ae3f44719243bc76d645d065c4d, type: 2}
    text: '!!! Hey! Shh! Trying to get our ears cut off or something!? (The nervous
      rat refuses to talk for the time being...)'
    options: []
    endConversation: 1
  - speaker: {fileID: 11400000, guid: de613ae3f44719243bc76d645d065c4d, type: 2}
    text: 'O-Oh, I see. Well, whatever you need, make it quick. '
    options: []
    endConversation: 0
  - speaker: {fileID: 11400000, guid: fe37e5f6c6e4ce940ab3b38f7087bab3, type: 2}
    text: Thanks. If I were to say, get anyone to buy some cheese, how would I go
      about it?
    options: []
    endConversation: 0
  - speaker: {fileID: 11400000, guid: de613ae3f44719243bc76d645d065c4d, type: 2}
    text: Ah, I get it... Well, if it were me, I'd definitley try to get the rat's
      trust. Do a favor or two for them.
    options: []
    endConversation: 0
  - speaker: {fileID: 11400000, guid: fe37e5f6c6e4ce940ab3b38f7087bab3, type: 2}
    text: Would you happen to have anything I could do for you...? Maybe in exchange
      for some business?
    options: []
    endConversation: 0
  - speaker: {fileID: 11400000, guid: de613ae3f44719243bc76d645d065c4d, type: 2}
    text: Well isn't it just my lucky day...!
    options: []
    endConversation: 0
  - speaker: {fileID: 11400000, guid: de613ae3f44719243bc76d645d065c4d, type: 2}
    text: 'I uh... seemed to have lost my favorite milk carton somewhere. If you
      can find it... then perhaps we can talk business. '
    options: []
    endConversation: 0
